[MASTER]
ignore=CVS,.git,__pycache__,.pytest_cache

[MESSAGES CONTROL]
# Temporarily disable some checks while we incrementally improve
disable=
    C0330,  # Wrong hanging indentation
    C0326,  # Bad whitespace
    W0511,  # TODO/FIXME comments
    R0801,  # Similar lines (duplicate-code)
    W1203,  # logging-fstring-interpolation
    W0718,  # broad-exception-caught
    C0415,  # import-outside-toplevel
    R1702,  # too-many-nested-blocks
    R1705,  # no-else-return
    R1723,  # no-else-break
    W0613,  # unused-argument
    C0302,  # too-many-lines
    W1309,  # f-string-without-interpolation
    R0903,  # too-few-public-methods
    C0301,  # line-too-long
    C0303,  # trailing-whitespace
    C0304,  # missing-final-newline

[FORMAT]
max-line-length=120

[DESIGN]
# More lenient thresholds to allow current code to pass
max-args=8
max-attributes=12
max-branches=15
max-locals=20
max-statements=75
min-public-methods=0

[BASIC]
good-names=i,j,k,db,id,_,e,ex,sp,url

[SIMILARITIES]
min-similarity-lines=20
